# Hetex AI — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite for local dev — swap to a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider — Anthropic (required for real AI responses)
ANTHROPIC_API_KEY=""

# Future providers (not yet wired, placeholders for when you add them)
# OPENAI_API_KEY=""
# GOOGLE_AI_API_KEY=""
