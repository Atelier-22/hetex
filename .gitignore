# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# --- Dependencies ---
node_modules/

# --- Next.js (aviel-web) ---
.next/
out/
next-env.d.ts

# --- Expo / React Native (aviel-mobile) ---
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
*.orig.*
/aviel-mobile/ios/
/aviel-mobile/android/

# --- Local database & uploads ---
*.db
*.db-journal
*.sqlite
*.sqlite3
uploads/

# --- Local fallback model (gguf weights, ~2 GB) ---
models/
*.gguf
*.gguf.partial

# --- Build / tooling output ---
dist/
*.tsbuildinfo
.deep-copilot/
.vercel/
coverage/

# --- Logs ---
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# --- OS / editor ---
.DS_Store
Thumbs.db

.vercel

# Re-stated here rather than relying on the rules at the top of this file: a
# bare `.env*` at the end silently overrode the `!.env.example` negation above,
# so a moved or newly added .env.example was ignored without anything saying so.
.env*
!.env.example
