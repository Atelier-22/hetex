# Hetex AI — frontend environment configuration
# Copy this file to .env.local and fill in real values. Never commit it.

# --- Hetex API ---
# The backend's base URL. NEXT_PUBLIC_ is required because the browser reads
# this, which means it must be set BEFORE the build runs, not just at runtime.
# Local:      http://localhost:4000
# Production: https://hetex-api.onrender.com  (your Render service URL)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- NextAuth ---
# Encrypts the session cookie. Generate with: openssl rand -base64 32
# This is NOT the same secret as the backend's JWT_SECRET.
NEXTAUTH_SECRET=""

# Must exactly match the URL the site is served from, or sign-in will fail.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
