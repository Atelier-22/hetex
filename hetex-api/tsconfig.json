{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // node16 rather than commonjs/node: TypeScript 7 removed the old "node"
    // (node10) resolution entirely. This pair emits CommonJS — package.json has
    // no "type": "module" — and is accepted by both TS 5 and TS 7.
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
