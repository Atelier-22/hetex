# Hetex API — environment configuration
# Copy to .env for local development. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local: a Postgres you run yourself.
# Production: Render's External Database URL (starts with postgresql://).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hetex"

# --- Auth ---
# Signs the bearer tokens used by both the web and mobile clients.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="30d"

# --- AI provider ---
# Without this, /chat returns a clear 503 instead of a fake response.
ANTHROPIC_API_KEY=""
# Any current Claude model id. Sonnet 4.6 is the default; claude-opus-5 is
# more capable and more expensive.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- CORS ---
# Comma-separated browser origins allowed to call this API. The deployed
# frontend's URL goes here. *.vercel.app preview URLs are allowed automatically.
CORS_ORIGINS="http://localhost:3000"

# --- Optional: web search tool (not implemented yet) ---
# WEB_SEARCH_PROVIDER=""
